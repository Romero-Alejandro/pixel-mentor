{
  "name": "pixel-mentor",
  "version": "0.0.1",
  "type": "module",
  "description": "Plataforma EdTech de tutorías interactivas para niños de 6-12 años",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --ignore-pattern '.agents/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/*.d.ts' --ignore-pattern '**/*.D.ts' --ignore-pattern 'node_modules/'",
    "format": "prettier . --write --ignore-path .prettierignore",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@pixel-mentor/eslint-config-custom": "workspace:*",
    "@pixel-mentor/prettier-config-custom": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.0",
    "eslint": "8.57.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "globals": "17.4.0",
    "husky": "^9.1.7",
    "jest": "30.2.0",
    "jest-mock-extended": "4.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "ts-jest": "29.4.6",
    "ts-node": "^10.9.2",
    "turbo": "2.8.14",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "apps/api/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "pnpm --filter @pixel-mentor/api typecheck"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": ">=2.0.8",
      "effect@<3.20.0": ">=3.20.0",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
      "axios@>=1.0.0 <1.15.0": ">=1.15.0",
      "axios@>=1.0.0 <1.15.1": ">=1.15.1",
      "axios@>=1.0.0 <1.15.2": ">=1.15.2",
      "ip-address@<=10.1.0": ">=10.1.1",
      "turbo@>=1.1.0 <2.9.14": ">=2.9.14",
      "react-router@>=7.0.0 <=7.14.1": ">=7.14.2",
      "react-router@>=7.7.0 <7.13.2": ">=7.13.2",
      "react-router@>=7.5.1 <7.13.2": ">=7.13.2",
      "react-router@>=7.0.0 <7.15.0": ">=7.15.0",
      "react-router@>=7.0.0 <7.14.0": ">=7.14.0",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0",
      "axios@>=1.7.0 <1.16.0": ">=1.16.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "react-router@>=7.12.0 <7.15.1": ">=7.15.1",
      "turbo@<=2.9.13": ">=2.9.14",
      "react-router@>=6.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.11.0 <7.18.0": ">=7.18.0",
      "react-router@>=6.4.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.0.0 <7.18.0": ">=7.18.0",
      "ip-address@<=10.3.0": ">=10.3.1",
      "react-router@>=7.0.0 <7.14.1": ">=7.14.1",
      "react-router@>=7.12.0 <7.18.2": ">=7.18.2",
      "vitest@>=4.0.0 <4.1.0": ">=4.1.0 <5.0.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "axios@>=1.0.0 <1.18.0": ">=1.18.0",
      "axios@>=1.13.0 <1.18.0": ">=1.18.0",
      "axios@>=1.7.0 <1.18.0": ">=1.18.0"
    }
  }
}
